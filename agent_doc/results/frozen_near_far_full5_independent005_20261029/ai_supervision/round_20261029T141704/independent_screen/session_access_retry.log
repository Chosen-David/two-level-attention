    41	def normalize_answer(s):
    42	    """Lower text and remove punctuation, articles and extra whitespace."""
    43	
    44	    def remove_articles(text):
    45	        return re.sub(r"\b(a|an|the)\b", " ", text)
    46	
    47	    def white_space_fix(text):
    48	        return " ".join(text.split())
    49	
    50	    def remove_punc(text):
    51	        exclude = set(string.punctuation)
    52	        return "".join(ch for ch in text if ch not in exclude)
    53	
    54	    def lower(text):
    55	        return text.lower()
    56	
    57	    return white_space_fix(remove_articles(remove_punc(lower(s))))
