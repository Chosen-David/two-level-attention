    91	class RegionCacheLayer(CacheLayerMixin):
    92	    is_compileable = False
    93	    is_sliding = False
    94	
    95	    def __init__(self, geometry):
    96	        super().__init__()
    97	        self.geometry = geometry
    98	        self.nodes = {}
    99	        self.head = None
   100	        self.logical_length = self.prompt_length = 0
   101	        self.frozen = False
   102	        self.skip_far = self.skip_near = False
   103	        self.permanently_dropped = 0
   104	
   105	    def lazy_initialization(self, key_states):
   106	        pass  # Shape and length are both needed; initialization occurs in update.
   107	
   108	    def _relink(self):
   109	        live = [self.nodes[name] for name in ('sink', 'far', 'near', 'near_staging', 'swa') if name in self.nodes]
   110	        for i, node in enumerate(live):
   111	            node.next = live[i+1] if i+1 < len(live) else None
   112	        self.head = live[0] if live else None
   113	
   114	    def freeze(self, skip_near=False, skip_far=False):
   115	        if self.frozen:
   116	            if (skip_near, skip_far) != (self.skip_near, self.skip_far):
   117	                raise ValueError('cannot change frozen request decisions')
   118	            return
   119	        if not self.logical_length:
   120	            raise ValueError('prefill required before freeze')
