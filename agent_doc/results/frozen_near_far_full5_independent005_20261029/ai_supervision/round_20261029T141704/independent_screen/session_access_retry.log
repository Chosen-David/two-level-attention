   239	    def freeze(self, decisions):
   240	        if set(decisions) != set(range(len(self.layers))):
   241	            raise ValueError('every layer must have a prefill decision')
   242	        for li, layer in enumerate(self.layers):
   243	            layer.freeze(**decisions[li])
