     1	"""Native post-RoPE profiling, independent near/far signals, no decode updates."""
     2	from dataclasses import dataclass
     3	import math
     4	import torch
     5	from .frozen_region_cache import RegionGeometry
     6	
     7	
     8	@dataclass(frozen=True)
     9	class GateConfig:
    10	    epsilon: float = .05
    11	    rows: int = 256
    12	    statistic: str = 'mean'
    13	    mode: str = 'dual'
    14	
    15	    def __post_init__(self):
    16	        if not math.isfinite(self.epsilon) or not 0 <= self.epsilon <= 1:
    17	            raise ValueError('epsilon must be in [0,1]')
    18	        if self.rows < 1 or self.statistic not in ('mean', 'p95') or self.mode not in ('full', 'far', 'near', 'dual'):
    19	            raise ValueError('invalid gate configuration')
    20	
    21	
    22	def profile_regions(q, k, geometry=RegionGeometry(), rows=256, chunk=16):
    23	    if q.ndim != 4 or q.shape[0] != 1 or q.shape[2] != k.shape[2]:
    24	        raise ValueError('one-shot unpadded B=1 prefill required')
    25	    length = q.shape[2]
    26	    n = min(rows, length)
    27	    heads, dim = q.shape[1], q.shape[-1]
    28	    kk = k.detach().float().repeat_interleave(heads//k.shape[1], 1)
    29	    pos = torch.arange(length, device=q.device)[None, :]
    30	    signals = {'near': [], 'far': []}
    31	    for start in range(length-n, length, chunk):
    32	        end = min(start+chunk, length)
    33	        qe = q.detach()[:, :, start:end].float()
    34	        scores = qe @ kk.transpose(-1, -2) * dim**-.5
    35	        qlen = torch.arange(start+1, end+1, device=q.device)[:, None]
    36	        scores.masked_fill_(pos >= qlen, -torch.inf)
    37	        probs = scores.softmax(-1)
    38	        sink_hi = torch.minimum(qlen, torch.tensor(geometry.sink, device=q.device))
    39	        near_hi = torch.maximum(sink_hi, qlen-geometry.window)
    40	        far_hi = torch.minimum(near_hi, torch.maximum(sink_hi, ((qlen-geometry.window-geometry.near)//geometry.page)*geometry.page))
    41	        masks = {'far': (pos >= sink_hi) & (pos < far_hi),
    42	                 'near': (pos >= far_hi) & (pos < near_hi)}
    43	        for name, mask in masks.items():
    44	            signals[name].append((probs*mask).sum(-1).mean((0, 1)).cpu())
    45	    return {name: {'mean': float(torch.cat(values).mean()),
    46	                   'p95': float(torch.quantile(torch.cat(values), .95)),
    47	                   'max': float(torch.cat(values).max())} for name, values in signals.items()}
    48	
    49	
    50	def decide_regions(profile, config, present_near=True, present_far=True):
    51	    n, f = (profile[name][config.statistic] for name in ('near', 'far'))
    52	    near = present_near and config.mode in ('near', 'dual') and n < config.epsilon
    53	    far = present_far and config.mode in ('far', 'dual') and f < config.epsilon
    54	    return dict(skip_near=bool(near), skip_far=bool(far))
     1	"""Request-local physical sink -> far -> near -> SWA cache for eager Qwen3.
     2	
     3	Far-skip and both-skip physically evict their unused nodes. Near-only skip keeps
     4	an explicit, attention-invisible staging node; its KV ages normally into far.
     5	Near-only skip saves attention work, not resident KV. No hidden full-history
     6	backup is retained. This exploration does not implement TLI selection,
     7	CUDA graphs, batching, offload, rewind, or beam search.
     8	"""
     9	from dataclasses import dataclass
    10	import torch
    11	from transformers.cache_utils import Cache, CacheLayerMixin
    12	
    13	
    14	@dataclass(frozen=True)
    15	class RegionGeometry:
    16	    sink: int = 4
    17	    near: int = 4096
    18	    window: int = 128
    19	    page: int = 64
    20	    max_new_tokens: int = 512
    21	
    22	    def __post_init__(self):
    23	        for name in ('sink', 'near', 'window', 'page', 'max_new_tokens'):
    24	            value = getattr(self, name)
    25	            if isinstance(value, bool) or not isinstance(value, int) or value < (0 if name == 'sink' else 1):
    26	                raise ValueError(f'invalid {name}: {value}')
    27	
    28	    def bounds(self, length):
    29	        sink_hi = min(self.sink, length)
    30	        near_hi = max(sink_hi, length-self.window)
    31	        far_hi = min(near_hi, max(sink_hi, ((length-self.window-self.near)//self.page)*self.page))
    32	        return sink_hi, far_hi, near_hi
    33	
    34	
    35	class KVNode:
    36	    """An independently owned fixed-capacity FIFO, with chronological reads."""
    37	    def __init__(self, name, capacity, template):
    38	        self.name, self.capacity = name, capacity
    39	        shape = (*template.shape[:-2], capacity, template.shape[-1])
    40	        self.keys = torch.empty(shape, device=template.device, dtype=template.dtype)
    41	        self.values = torch.empty_like(self.keys)
    42	        self.positions = [None]*capacity
    43	        self.head = self.size = 0
    44	        self.next = None
    45	        self.attention_visible = True
    46	
    47	    def append(self, keys, values, positions):
    48	        n = keys.shape[-2]
    49	        if n != len(positions) or n > self.capacity-self.size:
    50	            raise ValueError(f'{self.name} capacity exceeded or inconsistent positions')
    51	        if not n:
    52	            return
    53	        tail = (self.head+self.size) % self.capacity
    54	        first = min(n, self.capacity-tail)
    55	        self.keys[..., tail:tail+first, :].copy_(keys[..., :first, :])
    56	        self.values[..., tail:tail+first, :].copy_(values[..., :first, :])
    57	        self.positions[tail:tail+first] = positions[:first]
    58	        if first < n:
    59	            self.keys[..., :n-first, :].copy_(keys[..., first:, :])
    60	            self.values[..., :n-first, :].copy_(values[..., first:, :])
    61	            self.positions[:n-first] = positions[first:]
    62	        self.size += n
    63	
    64	    def peek(self):
    65	        if not self.size:
    66	            raise ValueError('empty queue')
    67	        return (self.keys[..., self.head:self.head+1, :],
    68	                self.values[..., self.head:self.head+1, :], self.positions[self.head])
    69	
    70	    def pop(self):
    71	        if not self.size:
    72	            raise ValueError('empty queue')
    73	        self.positions[self.head] = None
    74	        self.head = (self.head+1) % self.capacity
    75	        self.size -= 1
    76	
    77	    def read(self):
    78	        if self.head+self.size <= self.capacity:
    79	            return (self.keys[..., self.head:self.head+self.size, :],
    80	                    self.values[..., self.head:self.head+self.size, :],
    81	                    self.positions[self.head:self.head+self.size])
    82	        end = (self.head+self.size) % self.capacity
    83	        return (torch.cat((self.keys[..., self.head:, :], self.keys[..., :end, :]), -2),
    84	                torch.cat((self.values[..., self.head:, :], self.values[..., :end, :]), -2),
    85	                self.positions[self.head:]+self.positions[:end])
    86	
    87	    def resident_bytes(self):
    88	        return (self.keys.numel()+self.values.numel())*self.keys.element_size()
    89	
