            arms.append((f'{mode}_{eps:g}', config))
    prompts = json.loads((ROOT/'benchmark/LongBench/config/dataset2prompt.json').read_text())
    lengths = json.loads((ROOT/'benchmark/LongBench/config/dataset2maxlen.json').read_text())
