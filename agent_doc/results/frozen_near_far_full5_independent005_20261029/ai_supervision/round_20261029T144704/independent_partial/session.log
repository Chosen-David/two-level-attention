37: def _runcap_file_sha256(path):
38:     """结果文件字节 sha256——与 producer compute_result_binding 同口径。"""
39:     h = hashlib.sha256()
40:     with open(path, "rb") as f:
41:         for chunk in iter(lambda: f.read(1 << 20), b""):
42:             h.update(chunk)
43:     return h.hexdigest()
