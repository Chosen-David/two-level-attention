FILE sparse_attn/ops/frozen_region_gate.py
1: """Native post-RoPE profiling, independent near/far signals, no decode updates."""
2: from dataclasses import dataclass
3: import math
4: import torch
5: from .frozen_region_cache import RegionGeometry
6: 
7: 
8: @dataclass(frozen=True)
9: class GateConfig:
10:     epsilon: float = .05
11:     rows: int = 256
12:     statistic: str = 'mean'
13:     mode: str = 'dual'
14: 
15:     def __post_init__(self):
16:         if not math.isfinite(self.epsilon) or not 0 <= self.epsilon <= 1:
17:             raise ValueError('epsilon must be in [0,1]')
18:         if self.rows < 1 or self.statistic not in ('mean', 'p95') or self.mode not in ('full', 'far', 'near', 'dual'):
19:             raise ValueError('invalid gate configuration')
20: 
21: 
22: def profile_regions(q, k, geometry=RegionGeometry(), rows=256, chunk=16):
23:     if q.ndim != 4 or q.shape[0] != 1 or q.shape[2] != k.shape[2]:
24:         raise ValueError('one-shot unpadded B=1 prefill required')
25:     length = q.shape[2]
26:     n = min(rows, length)
27:     heads, dim = q.shape[1], q.shape[-1]
28:     kk = k.detach().float().repeat_interleave(heads//k.shape[1], 1)
29:     pos = torch.arange(length, device=q.device)[None, :]
30:     signals = {'near': [], 'far': []}
31:     for start in range(length-n, length, chunk):
32:         end = min(start+chunk, length)
33:         qe = q.detach()[:, :, start:end].float()
34:         scores = qe @ kk.transpose(-1, -2) * dim**-.5
35:         qlen = torch.arange(start+1, end+1, device=q.device)[:, None]
36:         scores.masked_fill_(pos >= qlen, -torch.inf)
37:         probs = scores.softmax(-1)
38:         sink_hi = torch.minimum(qlen, torch.tensor(geometry.sink, device=q.device))
39:         near_hi = torch.maximum(sink_hi, qlen-geometry.window)
40:         far_hi = torch.minimum(near_hi, torch.maximum(sink_hi, ((qlen-geometry.window-geometry.near)//geometry.page)*geometry.page))
41:         masks = {'far': (pos >= sink_hi) & (pos < far_hi),
42:                  'near': (pos >= far_hi) & (pos < near_hi)}
43:         for name, mask in masks.items():
44:             signals[name].append((probs*mask).sum(-1).mean((0, 1)).cpu())
45:     return {name: {'mean': float(torch.cat(values).mean()),
46:                    'p95': float(torch.quantile(torch.cat(values), .95)),
47:                    'max': float(torch.cat(values).max())} for name, values in signals.items()}
48: 
49: 
50: def decide_regions(profile, config, present_near=True, present_far=True):
51:     n, f = (profile[name][config.statistic] for name in ('near', 'far'))
52:     near = present_near and config.mode in ('near', 'dual') and n < config.epsilon
53:     far = present_far and config.mode in ('far', 'dual') and f < config.epsilon
54:     return dict(skip_near=bool(near), skip_far=bool(far))

