83 def generate(model, tokenizer, ids, max_new_tokens, config, device):
84     geometry = RegionGeometry(max_new_tokens=max_new_tokens)
85     cache = FrozenRegionCache(model.config.num_hidden_layers, geometry)
86     eos = model.generation_config.eos_token_id
87     eos = eos if isinstance(eos, list) else [eos]
88     if getattr(model, '_frozen_tli', False):
89         cache.tli_regions = True
90         for module in model.model.layers:
91             module.self_attn.indexer.clear()
92             module.self_attn.indexer.skip_far = False
93     start = time.time()
94     with torch.inference_mode():
95         with capture_profiles(cache, geometry, config) as profiles:
96             out = model(torch.tensor([ids], device=device), past_key_values=cache, use_cache=True, logits_to_keep=1)
97         if len(profiles) != model.config.num_hidden_layers:
98             raise ValueError('incomplete native layer profiling')
99         before = cache.report()
100         decisions = {li: decide_regions(p, config,
101                      present_near=cache.layers[li].nodes['near'].size>0,
102                      present_far=cache.layers[li].nodes['far'].size>0) for li,p in profiles.items()}
103         cache.freeze(decisions)
104         after = cache.report()
105         for li, decision in decisions.items():
106             if decision['skip_near'] and not decision['skip_far']:
107                 nodes = after['layers'][li]['nodes']
108                 if 'near_staging' not in nodes or nodes['near_staging']['attention_visible']:
109                     raise ValueError('near-only must retain invisible staging KV')
110                 before_bytes = sum(n['kv_bytes'] for n in before['layers'][li]['nodes'].values())
111                 after_bytes = sum(n['kv_bytes'] for n in nodes.values())
112                 if before_bytes != after_bytes:
113                     raise ValueError('near-only must not claim a resident KV reduction')
114         generated = []
115         for _ in range(max_new_tokens):
116             token = out.logits[:, -1].argmax(-1, keepdim=True)
117             generated.append(int(token))
118             if int(token) in eos or len(generated) == max_new_tokens:
119                 break
120             out = model(token, past_key_values=cache, attention_mask={'full_attention':None},
121                         use_cache=True, logits_to_keep=1)
122         final = cache.report()
123         receipts = {i: getattr(layer, 'tli_receipt', None) for i,layer in enumerate(cache.layers)}
124         if getattr(model, '_frozen_tli', False) and len(generated)>1 and not all(receipts.values()):
125             raise ValueError('missing real TLI decode receipts')
126     counts = {name:0 for name in ('keep','near','far','both')}
127     for d in decisions.values():
128         counts['both' if d['skip_near'] and d['skip_far'] else 'near' if d['skip_near'] else 'far' if d['skip_far'] else 'keep'] += 1
129     result = dict(generated_ids=generated, prediction=tokenizer.decode(generated, skip_special_tokens=True),
130         generated_tokens=len(generated), wall_seconds=time.time()-start, profiles=profiles,
131         decisions=decisions, gate_counts=counts, tli_receipts=receipts, prefill_full_kv=before,
132         frozen_kv=after, final_kv=final,
133         measured_scope='physical node KV storage; eager gather temporaries excluded, no latency claim')
134     del out, cache
135     return result
