63 @contextmanager
64 def capture_profiles(cache, geometry, config):
65     original = ALL_ATTENTION_FUNCTIONS['sdpa']
66     profiles = {}
67     def profiled(module, query, key, value, *args, **kwargs):
68         li = module.layer_idx
69         if not cache.layers[li].frozen:
70             if li in profiles:
71                 raise ValueError('multiple prefill chunks unsupported')
72             profiles[li] = profile_regions(query, key, geometry, rows=config.rows)
73         return original(module, query, key, value, *args, **kwargs)
74     ALL_ATTENTION_FUNCTIONS['sdpa'] = profiled
75     try:
76         yield profiles
77     finally:
78         ALL_ATTENTION_FUNCTIONS['sdpa'] = original
