28 def region_mask(indexer, q, k, positions, length, scale):
29     """Q/K [1,S,H,D], positions enumerate visible physical K in order."""
30     if os.environ.get('TLI_FINE_GATHER', '1') != '0':
31         raise ValueError('frozen reference requires TLI_FINE_GATHER=0')
32     idx = indexer
33     if (idx.subspace != 'tail' or idx.l2_subspace != 'same' or idx.gamma is not None
34             or idx._basis_all is not None or idx.far_select != '4bit'
35             or idx.near_select != '4bit' or idx.per_q_head or idx.enable_async):
36         raise ValueError('frozen reference supports ordinary shared-head tail TLI only')
37     dims = idx._subspace_indices(k.device)
38     ids = torch.tensor(positions, device=k.device, dtype=torch.long)
39     bs = idx.args.tia_block_size
40     padded = (length+bs-1)//bs*bs
41     projected = k.new_zeros((1,padded,k.shape[2],dims.numel()))
42     projected[:,ids] = k.index_select(-1,dims)
43     pages = projected.reshape(1,-1,bs,k.shape[2],dims.numel())
44     fine = projected[:,:length]
45     if idx.l2_quant:
46         fine = idx.min_max_per_token_quant(fine)
47     cu = torch.tensor([0,length],device=k.device,dtype=torch.int32)
48     dictionary = dict(k_min=pages.amin(2), k_max=pages.amax(2),
49         k_avg=pages.mean(2), k_qat=fine,
50         cu_seqlens_k_coarse=torch.tensor([0,padded//bs],device=k.device,dtype=torch.int32),
51         cu_seqlens_k_fine=cu, valid_length=length)
52     qids = torch.tensor([length-1], device=k.device, dtype=torch.int32)
53     scores = idx.compute_score(q,qids,dictionary,scale)
54     if scores.get('cand_idx') is not None:
55         raise ValueError('unexpected candidate-only scorer in reference')
56     visible = torch.zeros(length,device=k.device,dtype=torch.bool)
57     visible[ids] = True
58     scores['score_fine'].masked_fill_(~visible, float('-inf'))
59     mask = idx.compute_mask(qids,scores)
60     # L1 bypass pages and zero-probability quota fillers must never restore
61     # deleted/staged tokens. Project mask onto physically visible positions.
62     compact_mask = mask.index_select(-1,ids)
63     return compact_mask, dict(subspace=idx.subspace,dimensions=dims.tolist(),
64         logical_tokens=length,visible_tokens=len(positions),
65         selected_per_kv_head=compact_mask.sum(-1).flatten().tolist(),
66         scorer='TLIIndexer.compute_score',selector='TLIIndexer.compute_mask')
