FILE sparse_attn/ops/frozen_region_tli.py
1 """Eager TLI reference adapter for physically segmented region caches.
2 
3 Reuse TLI's actual compute_score/compute_mask, including tail dimensions and
4 L1/L2 budgets. Only compact projected key scratch uses logical addressing;
5 full-width K/V remain in surviving nodes. This is a quality reference, not a
6 latency or peak-memory optimization. No scoring reads near_staging.
7 """
8 import argparse
9 import os
10 import torch
11 from sparse_attn.arguments import add_sparse_attn_args
12 from .eager_decoding import eager_decoding_attn
13 
14 
