17     add_sparse_attn_args(parser)
18     return parser.parse_args(['--method','tli', '--tli_far_method','minmax',
19         '--tli_near_method','avg', '--tli_near_pages','32',
20         '--tli_near_tokens','off', '--tli_near_len','4096',
21         '--tli_subspace','tail', '--tia_level2_cmp_ratio','4',
22         '--tli_sink_tokens','4', '--tli_swa_size','128',
23         '--tia_level1_topk','128', '--tia_level2_topk','1024',
24         '--tli_enable_layer_skip','false', '--tli_far_skip_backend','legacy',
25         '--tli_far_skip_cache','retain'])
