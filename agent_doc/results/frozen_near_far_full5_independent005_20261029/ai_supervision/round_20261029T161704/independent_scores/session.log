            try:os.kill(owner['pid'],0)
            except ProcessLookupError:pass
            else:return False
            if _lock_target(path)!=target:return False
            path.unlink()
            target.unlink(missing_ok=True)
            return True
        except (FileNotFoundError,ValueError,KeyError,PermissionError):
            return False


@contextmanager
