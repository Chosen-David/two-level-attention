def _runcap_file_sha256(path):
    """结果文件字节 sha256——与 producer compute_result_binding 同口径。"""
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


