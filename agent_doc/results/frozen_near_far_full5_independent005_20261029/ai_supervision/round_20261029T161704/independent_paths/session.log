114     def freeze(self, skip_near=False, skip_far=False):
115         if self.frozen:
116             if (skip_near, skip_far) != (self.skip_near, self.skip_far):
117                 raise ValueError('cannot change frozen request decisions')
118             return
119         if not self.logical_length:
120             raise ValueError('prefill required before freeze')
121         for name, evict in (('near', skip_near and skip_far), ('far', skip_far)):
122             if evict:
123                 node = self.nodes.pop(name)
124                 self.permanently_dropped += node.size
125                 node.next = None
126         if skip_near and not skip_far:
127             node = self.nodes.pop('near')
128             node.name = 'near_staging'
129             node.attention_visible = False
130             self.nodes['near_staging'] = node
131         self.skip_near, self.skip_far = bool(skip_near), bool(skip_far)
132         self.frozen = True
133         self._relink()
134 
135     def update(self, keys, values, cache_kwargs=None):
136         if keys.shape != values.shape or keys.ndim != 4 or keys.shape[0] != 1:
137             raise ValueError('only unpadded B=1, equal-width Qwen K/V supported')
138         if torch.is_grad_enabled() and (keys.requires_grad or values.requires_grad):
139             raise ValueError('inference-only cache')
140         n = keys.shape[-2]
141         positions = (cache_kwargs or {}).get('cache_position')
142         expected = list(range(self.logical_length, self.logical_length+n))
143         if positions is not None and positions.tolist() != expected:
144             raise ValueError('non-monotonic or padded positions unsupported')
145         if not self.logical_length:
146             if self.frozen:
147                 raise ValueError('cache reset required')
148             g = self.geometry
149             sink_hi, far_hi, near_hi = g.bounds(n)
150             specs = [('sink', g.sink, 0, sink_hi),
151                      ('far', far_hi-sink_hi+g.max_new_tokens+g.page, sink_hi, far_hi),
152                      ('near', g.near+g.page-1, far_hi, near_hi),
153                      ('swa', g.window, near_hi, n)]
154             for name, capacity, lo, hi in specs:
155                 node = KVNode(name, capacity, keys)
156                 node.append(keys[..., lo:hi, :], values[..., lo:hi, :], list(range(lo, hi)))
157                 self.nodes[name] = node
158             self.logical_length = self.prompt_length = n
159             self._relink()
160             return keys, values  # Dense prefill sees original, complete K/V.
161         if not self.frozen or n != 1:
162             raise ValueError('freeze after one-shot prefill; decode must be one token')
163         if self.logical_length-self.prompt_length >= self.geometry.max_new_tokens:
164             raise ValueError('configured generation capacity exceeded')
165         position = self.logical_length
166         new_length = position+1
167         _, new_far_hi, _ = self.geometry.bounds(new_length)
168         near = self.nodes.get('near') or self.nodes.get('near_staging')
169         far = self.nodes.get('far')
170         if near is not None:
171             while near.size and near.peek()[2] < new_far_hi:
172                 old_k, old_v, old_pos = near.peek()
173                 if far is not None:
174                     far.append(old_k, old_v, [old_pos])
175                 else:
176                     self.permanently_dropped += 1
177                 near.pop()
178         if position < self.geometry.sink:
179             self.nodes['sink'].append(keys, values, [position])
180         else:
181             swa = self.nodes['swa']
182             if swa.size == swa.capacity:
183                 old_k, old_v, old_pos = swa.peek()
184                 if near is not None:
185                     near.append(old_k, old_v, [old_pos])
186                 else:
187                     self.permanently_dropped += 1
188                 swa.pop()
189             swa.append(keys, values, [position])
190         self.logical_length = new_length
191         k, v, _ = self.gather()
192         return k, v
193 
194     def gather(self):
195         keys, values, positions = [], [], []
196         node = self.head
197         while node is not None:
198             if node.size and node.attention_visible:
199                 k, v, pos = node.read()
200                 keys.append(k); values.append(v); positions.extend(pos)
201             node = node.next
202         return torch.cat(keys, -2), torch.cat(values, -2), positions
203 
204     def get_mask_sizes(self, cache_position):
205         return self.logical_length+cache_position.shape[0], 0
206 
207     def get_seq_length(self):
208         return self.logical_length
209 
210     def get_max_cache_shape(self):
211         return -1
212 
213     def reorder_cache(self, beam_idx):
214         raise ValueError('beam/reorder unsupported')
215 
216     def reset(self):
217         raise ValueError('construct a new request cache instead of resetting')
218 
219     def report(self):
220         order = []
221         node = self.head
222         while node is not None:
223             order.append(node.name)
224             node = node.next
225         return dict(logical_length=self.logical_length, skip_near=self.skip_near, skip_far=self.skip_far,
226                     nodes={name: dict(tokens=node.size, capacity=node.capacity, kv_bytes=node.resident_bytes(),
227                                       attention_visible=node.attention_visible) for name, node in self.nodes.items()},
228                     stored_tokens=sum(node.size for node in self.nodes.values()),
229                     attention_tokens=sum(node.size for node in self.nodes.values() if node.attention_visible),
230                     linked_order=order,
231                     attention_order=[name for name in order if self.nodes[name].attention_visible],
232                     permanently_dropped=self.permanently_dropped)
