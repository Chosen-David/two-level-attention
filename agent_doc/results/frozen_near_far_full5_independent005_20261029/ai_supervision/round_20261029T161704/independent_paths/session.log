69 def decode(module,q,k,v,cache,cache_position):
70     layer = cache.layers[module.layer_idx]
71     if q.shape[:1] != (1,) or q.shape[-2] != 1 or not layer.frozen:
72         raise ValueError('frozen TLI requires frozen B1 single-token decode')
73     k,v = cache.update(k,v,module.layer_idx,dict(cache_position=cache_position))
74     positions = layer.gather()[2]
75     q,k,v = (x.transpose(1,2).contiguous() for x in (q,k,v))
76     idx = module.indexer
77     idx.skip_far = layer.skip_far
78     mask,receipt = region_mask(idx,q,k,positions,layer.logical_length,module.scaling)
79     receipt.update(skip_near=layer.skip_near,skip_far=layer.skip_far)
80     layer.tli_receipt = receipt
81     cu = torch.tensor([0,len(positions)],device=k.device,dtype=torch.int32)
82     return eager_decoding_attn(q,k,v,mask,1,cu,softmax_scale=module.scaling)
