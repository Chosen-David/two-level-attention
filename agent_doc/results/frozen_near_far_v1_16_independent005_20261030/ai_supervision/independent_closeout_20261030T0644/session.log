"""Specialty B10000 seed42 consecutive RNG; copied from sealed reviewed tool."""
import collections,math
import numpy as np
ARMS=("full","far_0.05","dual_0.05")
PAIRS=(("dual_0.05","far_0.05"),("far_0.05","full"),("dual_0.05","full"))
def require(ok, why):
    if not ok:
        raise ValueError(why)

def compare(a, b, path='$'):
    if isinstance(b, dict):
        require(isinstance(a, dict) and set(a) == set(b), path + ': keys')
        for k in b:
            compare(a[k], b[k], path + '.' + k)
    elif isinstance(b, list):
        require(isinstance(a, list) and len(a) == len(b), path + ': length')
        for i, (x, y) in enumerate(zip(a, b)):
            compare(x, y, f'{path}[{i}]')
    elif isinstance(b, float):
        require(type(a) in (float, int) and math.isfinite(a) and math.isfinite(b) and (abs(a - b) <= 1e-10), path + ': numeric')
    else:
        require(type(a) == type(b) and a == b, path + ': value/type')

def statistics(records, n):
    require(len(records) == n, 'partial records: statistics forbidden')
    rng = np.random.default_rng(42)
    result = dict(status='pending independent validation', n=n, arms={}, comparisons={})
    for arm in ARMS:
        scores = [r['arms'][arm]['score'] for r in records]
        require(all((type(x) in (int, float) and math.isfinite(x) and (0 <= x <= 1) for x in scores)), 'score domain')
        counts = collections.Counter(dict(keep=0, far=0, near=0, both=0))
        near = far = 0
        for r in records:
            t = r['arms'][arm]
            local = collections.Counter(dict(keep=0, far=0, near=0, both=0))
            for d in t['decisions'].values():
                sn, sf = (d['skip_near'], d['skip_far'])
                require(type(sn) == type(sf) == bool, 'gate bool')
                local['both' if sn and sf else 'near' if sn else 'far' if sf else 'keep'] += 1
            compare(t['gate_counts'], dict(local), 'raw gate_counts')
            counts.update(local)
            near += any((d['skip_near'] for d in t['decisions'].values()))
            far += any((d['skip_far'] for d in t['decisions'].values()))
        result['arms'][arm] = dict(score_0_100=math.fsum(scores) / n * 100, gate_counts=dict(counts), near_active_requests=near, far_active_requests=far)
    for arm, ref in PAIRS:
        d = np.array([100 * (r['arms'][arm]['score'] - r['arms'][ref]['score']) for r in records])
        draws = [float(np.mean(d[rng.integers(n, size=n)])) for _ in range(10000)]
        result['comparisons'][arm + '-vs-' + ref] = dict(delta_pp=float(d.mean()), ci95_pp=np.percentile(draws, [2.5, 97.5]).tolist(), degraded=int(sum(d < 0)), improved=int(sum(d > 0)), same_score=int(sum(d == 0)), same_generated_ids=sum((r['arms'][arm]['generated_ids'] == r['arms'][ref]['generated_ids'] for r in records)))
    result['scope'] = '10000 paired request bootstrap, seed42, no equivalence claim; gates-off is TLI, not dense FullKV; no latency claim'
    return result

