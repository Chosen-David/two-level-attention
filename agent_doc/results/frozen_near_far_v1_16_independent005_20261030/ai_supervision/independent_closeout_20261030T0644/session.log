        for name,v in self.bindings.items():
            require(sha(Path(v['origin']).read_bytes())==v['sha256']==sha((self.out/name).read_bytes()),'changed '+name)
        put(self.out/'CAPTURE_BINDINGS.json',self.bindings)

def preflight(root):
    """Only metadata and record completeness; never decode/score/tokenize."""
    entries=[]
    for p in sorted((root/'requests/qasper').glob('*.json')):
        b=p.read_bytes();require(p.read_bytes()==b,'unstable raw');r=json.loads(b)
        entries.append((p,b,r))
    completed=sum(r.get('status')=='complete' for _,_,r in entries)
    if len(entries)!=200 or completed!=200:
        return None,dict(status='pending',complete=completed,files=len(entries),expected=200,tokenization='not run',quality_statistics='not computed',full_acceptance='pending')
    require({r['row_index'] for _,_,r in entries}==set(range(200)),'200 unique rows required')
    for p,b,r in entries:
        require(r['dataset']=='qasper' and r['identity']==IDENTITY,'current Qasper identity')
        require(p.stem==f"{r['row_index']:04d}" and set(r['arms'])==set(ARMS),'filename/600 arms')
    return entries,None

def covering_ranks(cfg):
    offset=0;mapping={}
    for ds in cfg['datasets']:
        for i in cfg['selected_rows'][ds]:
            if ds=='qasper':mapping[i]=offset%cfg['world_size']
            offset+=1
    require(set(mapping)==set(range(200)),'Qasper selected coverage')
    return mapping

def validate_manifests(cap,cfg,identity,mapping):
    ranks=set(mapping.values())
    for rank in sorted(ranks):
        m=json.loads(cap.take(RUN/f'manifest_rank{rank}.json',f'manifests/manifest_rank{rank}.json'))
        require(m['rank']==rank and m['identity']==identity and m['protocol']==cfg,'covering manifest mismatch '+str(rank))
    return ranks

def sample_facts(records):
    from specialty_statistics import PAIRS
    result=[]
    for r in records:
        comp={}
        for a,b in PAIRS:
            d=100*(r['arms'][a]['score']-r['arms'][b]['score'])
            comp[a+'-vs-'+b]=dict(delta_pp=d,direction='improved' if d>0 else 'degraded' if d<0 else 'same_score',same_generated_ids=r['arms'][a]['generated_ids']==r['arms'][b]['generated_ids'])
        result.append(dict(row_index=r['row_index'],comparisons=comp,gates={a:dict(counts=r['arms'][a]['gate_counts'],near_active=any(x['skip_near'] for x in r['arms'][a]['decisions'].values()),far_active=any(x['skip_far'] for x in r['arms'][a]['decisions'].values()),both_active=any(x['skip_near'] and x['skip_far'] for x in r['arms'][a]['decisions'].values())) for a in ARMS}))
    return result

def full_check(entries,cap):
    m=json.loads(cap.take(RUN/'manifest_rank0.json','context/manifest_rank0.json'));cfg=m['protocol']
    require(m['identity']==IDENTITY==sha(json.dumps(cfg,sort_keys=True).encode()),'manifest identity')
    require(cfg['git_head']==COMMIT and cfg['world_size']==128 and cfg['context_cap']==31500 and cfg['thresholds']==[.05] and cfg['statistic']=='mean' and cfg['full_dataset'],'fixed protocol')
    require(cfg['selected_counts']['qasper']==cfg['dataset_counts']['qasper']==200,'protocol denominator')
    import numpy as np
    require(cfg['selected_rows']['qasper']==np.random.default_rng(42).permutation(200).tolist(),'selected seed42 ordering')
    mapping=covering_ranks(cfg);ranks=validate_manifests(cap,cfg,IDENTITY,mapping)
    require(subprocess.check_output(['git','rev-parse','HEAD'],cwd=SRC,text=True).strip()==COMMIT,'source HEAD')
    for name,h in cfg['source_sha256'].items():
        b=cap.take(SRC/name,'source/'+name)
        require(sha(b)==h==sha(subprocess.check_output(['git','show',COMMIT+':'+name],cwd=SRC)),'source bytes '+name)
    for name in ['benchmark/LongBench/eval.py','benchmark/LongBench/metrics.py','benchmark/LongBench/config/dataset2prompt.json','benchmark/LongBench/config/dataset2maxlen.json']:
        b=cap.take(SRC/name,'source/'+name)
        require(sha(b)==sha(subprocess.check_output(['git','show',COMMIT+':'+name],cwd=SRC)),'official reference/config '+name)
    raw=[]
    for p,b,r in entries:
        frozen=cap.take(p,'requests/qasper/'+p.name);require(frozen==b,'raw changed since preflight');raw.append(r)
    require(len(raw)==200 and sum(len(r['arms']) for r in raw)==600,'200/600')
    data=cap.take(Path('/home/wangyuanshuo02/datasets/LongBench/data/qasper.jsonl'),'inputs/qasper.jsonl')
    require(sha(data)==cfg['dataset_sha256']['qasper'],'dataset SHA')
    rows=[json.loads(x) for x in data.splitlines()];require(len(rows)==200,'dataset200')
    model=Path(cfg['model'])
    for name in ['config.json','tokenizer_config.json','generation_config.json','tokenizer.json','vocab.json','merges.txt','special_tokens_map.json','added_tokens.json','chat_template.jinja','model.safetensors.index.json']:
        if (model/name).is_file():cap.take(model/name,'tokenizer/'+name)
    tokdir=cap.out/'tokenizer'
    for filename,key in [('config.json','model_config_sha256'),('tokenizer_config.json','tokenizer_config_sha256')]:require(sha((tokdir/filename).read_bytes())==cfg[key],filename)
    from transformers import AutoTokenizer
    tok=AutoTokenizer.from_pretrained(tokdir,local_files_only=True)
    mc=json.loads((tokdir/'config.json').read_bytes());eos=json.loads((tokdir/'generation_config.json').read_bytes())['eos_token_id'];eos=eos if isinstance(eos,list) else [eos]
    sys.path.insert(0,str(SRC))
    from benchmark.LongBench.eval import sample_score
    from qasper_record_checks import verify_record
    pr=json.loads((cap.out/'source/benchmark/LongBench/config/dataset2prompt.json').read_bytes())
    lengths=json.loads((cap.out/'source/benchmark/LongBench/config/dataset2maxlen.json').read_bytes())
    put(cap.out/'ENVIRONMENT.json',dict(python=sys.version,executable=sys.executable,platform=platform.platform(),CUDA_VISIBLE_DEVICES=os.environ['CUDA_VISIBLE_DEVICES'],packages={name:importlib.metadata.version(name) for name in ['numpy','transformers','torch','jieba','rouge']}))
    checks=[]
    for r in raw:checks.append(verify_record(r,{'qasper':rows},cfg,pr,lengths,tok,mc,eos,sample_score))
    # Do not compute any quality aggregates unless ALL200 records passed.
    from specialty_statistics import statistics,PAIRS
    summary=statistics(raw,200);per_sample=sample_facts(raw)
    facts=dict(status='CPU checks passed; report facts awaiting independent admission',full_acceptance='pending',dataset='qasper',source_commit=COMMIT,identity=IDENTITY,n=200,outputs=600,bootstrap=10000,seed=42,sample_order='ascending row_index 0..199',comparison_order=[a+'-vs-'+b for a,b in PAIRS],primary='dual_0.05-vs-far_0.05',full_baseline='TLI gates-off; not dense FullKV',summary=summary,per_sample=per_sample,
        engineering_3pp={k:dict(delta_pp=v['delta_pp'],within_point_estimate_tolerance=v['delta_pp']>=-3) for k,v in summary['comparisons'].items()},
        interpretation='3pp point estimate engineering tolerance only; CI including zero does not establish equivalence',
        limitations=['No independent GPU regeneration','Q/K not saved; no independent real attention mass reconstruction','Post-launch tokenizer/weight evidence cannot prove historical in-memory weights','Final production report prose and experiment-result artifact contract still require review'])
    cap.finish()
    facts['raw_sha256']={k:v['sha256'] for k,v in cap.bindings.items() if k.startswith('requests/')}
    facts['covering_rank_manifests']=sorted(ranks)
    facts['row_to_rank']=mapping
    put(cap.out/'INPUT_AND_RECORD_CHECKS.json',checks);put(cap.out/'QASPER_REPORT_FACTS.json',facts)
    return dict(status='scoped CPU checks passed',full_acceptance='pending',rows=200,arms=600,covering_manifests=len(ranks),report_facts='QASPER_REPORT_FACTS.json',independent_gpu_regeneration=False)

def main():
    out=BASE/('snapshot_'+datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%S%fZ'));out.mkdir();cap=Capture(out)
    code=2
    try:
        entries,pending=preflight(RUN)
        if pending:result=pending
        else:result=full_check(entries,cap);code=0
    except Exception as e:
        result=dict(status='invalid or inconclusive',full_acceptance='pending',error=type(e).__name__+': '+str(e))
    finally:put(out/'CAPTURE_BINDINGS.json',cap.bindings)
    put(out/'RESULT.json',result);print(json.dumps(result,indent=2));print('SNAPSHOT',out);return code
if __name__=='__main__':raise SystemExit(main())

