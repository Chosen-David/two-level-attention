import collections,difflib,math,re,string,hashlib,json
from cache_receipts_check import check_record as cache_extra

def sha(b):return hashlib.sha256(b).hexdigest()
def check(ok,label):
    if not ok:raise ValueError(label)
def norm(s):
    return re.sub('\\b(a|an|the)\\b', ' ', s.lower().translate(str.maketrans('', '', string.punctuation))).split()

def score(ds, pred, ans, classes):
    if ds in {'trec', 'triviaqa', 'samsum'}:
        pred = pred.lstrip('\n').split('\n')[0]
    scores = []
    for gold in ans:
        if ds in {'narrativeqa', 'qasper', 'multifieldqa_en', 'hotpotqa', '2wikimqa', 'musique', 'triviaqa'}:
            a, b = (norm(pred), norm(gold))
            overlap = sum((collections.Counter(a) & collections.Counter(b)).values())
            s = 2 * overlap / (len(a) + len(b)) if overlap else 0.0
        elif ds in {'lcc', 'repobench-p'}:
            line = next((x for x in pred.lstrip('\n').split('\n') if not any((z in x for z in ['`', '#', '//']))), '')
            s = round(100 * difflib.SequenceMatcher(None, line, gold).ratio()) / 100
        elif ds in {'passage_count', 'passage_retrieval_en'}:
            nums = re.findall('\\d+', pred)
            target = re.search('Paragraph (\\d+)', gold).group(1) if ds == 'passage_retrieval_en' else str(gold)
            s = sum((x == target for x in nums)) / len(nums) if nums else 0
        elif ds == 'trec':
            hits = [x for x in classes if x in pred]
            for x in hits[:]:
                if x in gold and x != gold:
                    hits.remove(x)
            s = 1 / len(hits) if gold in hits else 0
        else:
            from rouge import Rouge
            try:
                s = Rouge().get_scores([pred], [gold], avg=True)['rouge-l']['f']
            except ValueError:
                s = 0.0
        scores.append(s)
    return max([0.0] + scores)

def bounds(n):
    return (min(4, n), min(max(min(4, n), n - 128), max(min(4, n), (n - 4224) // 64 * 64)), max(min(4, n), n - 128))

