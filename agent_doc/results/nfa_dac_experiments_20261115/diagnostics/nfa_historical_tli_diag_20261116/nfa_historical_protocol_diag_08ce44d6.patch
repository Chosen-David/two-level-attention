+def _ruler_eos_ids(model, tokenizer):
+    """隔离诊断：只收集模型声明的 EOS，不把换行或 pad 当停止符。"""
+    configured = getattr(
+        getattr(model, "generation_config", None), "eos_token_id", None)
+    if configured is None:
+        configured = ()
+    elif not isinstance(configured, (list, tuple)):
+        configured = (configured,)
+    candidates = (*configured, getattr(tokenizer, "eos_token_id", None))
+    return tuple(dict.fromkeys(
+        token for token in candidates
+        if isinstance(token, int) and not isinstance(token, bool) and token >= 0))
+
+
+def _greedy_next(logits, eos_ids, generated_count):
+    """隔离诊断：在不足 min-new 时先屏蔽 EOS，再执行 greedy argmax。"""
+    next_logits = logits[:, -1, :]
+    if generated_count < MIN_NEW_TOKENS and eos_ids:
+        next_logits = next_logits.clone()
+        next_logits[:, list(eos_ids)] = -float("inf")
+    return next_logits.argmax(dim=-1).unsqueeze(1)
+
