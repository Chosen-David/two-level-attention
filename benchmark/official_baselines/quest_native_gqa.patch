+def _topk_workspace_shape(num_heads, length, dtype):
+    # 与 RAFT calc_buf_len 一致：FP16/BF16 value、Int32 index，按128元素向下对齐。
+    value_size = torch.empty((), dtype=dtype).element_size()
+    index_size = torch.empty((), dtype=torch.int32).element_size()
+    ratio = 2 + 2 * index_size // value_size
+    alignment = 256 // min(value_size, index_size)
+    buf_len = (length // (ratio * 8)) // alignment * alignment
+    elems_per_head = buf_len * 2 * (value_size + index_size) // value_size
+    return (num_heads, elems_per_head)
